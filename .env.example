# Database
# Leave unset (or "pglite") for zero-setup local dev: an embedded Postgres (PGlite) stored in ./.data/pglite.
# For a real Postgres server (docker compose up -d), use:
# DATABASE_URL=postgres://khamar:khamar@localhost:5432/khamar
DATABASE_URL=pglite

# Secret used to hash OTP codes. 32+ random characters. Generate with: openssl rand -base64 32
OTP_SECRET=change-me-to-a-long-random-string-32chars

# SMS provider: "console" logs codes to the server terminal. Real gateways plug in at src/server/sms.ts
SMS_PROVIDER=console

# Dev only: show the OTP on the login screen so you can sign in without SMS. Ignored in production.
OTP_DEBUG=true
